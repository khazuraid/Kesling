DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@postgres:5432/kesling_cirebon
REDIS_URL=redis://redis:6379
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
