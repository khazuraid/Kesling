# Copy this file and fill in your values before running docker compose
# cp .env.docker.example .env.docker
#
# SECURITY NOTICE:
# - Generate NEXTAUTH_SECRET with: openssl rand -base64 32
# - In production behind reverse proxy, set NEXTAUTH_URL with https://
# - Do not commit .env.docker to git

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@postgres:5432/kesling_cirebon
REDIS_URL=redis://redis:6379
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# ── Akun seed (opsional) ─────────────────────────────────────────────
# Tanpa nilai ini, tidak ada akun yang dibuat oleh seed — login pertama
# harus dibuat manual. Isi dengan bcrypt hash, BUKAN password polos:
#   node -e "console.log(require('bcryptjs').hashSync('password',12))"
SEED_DEFAULT_PASSWORD_HASH=
