{
  "name": "apps-kes",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "db:migrate": "pnpm --filter @apps-kes/database migrate",
    "db:seed": "pnpm --filter @apps-kes/database seed",
    "db:studio": "pnpm --filter @apps-kes/database studio"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@commitlint/cli": "21.0.2",
    "@commitlint/config-conventional": "21.0.2",
    "@types/pg": "^8.20.0",
    "lefthook": "2.1.9",
    "turbo": "2.9.18"
  },
  "packageManager": "pnpm@11.1.0",
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "pg": "^8.22.0"
  }
}
