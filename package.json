{
  "name": "apps-kes",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "db:migrate": "pnpm --filter @apps-kes/database migrate",
    "db:seed": "pnpm --filter @apps-kes/database seed",
    "db:studio": "pnpm --filter @apps-kes/database studio",
    "mobile:start": "pnpm --filter @apps-kes/mobile start",
    "mobile:ios": "pnpm --filter @apps-kes/mobile ios"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@types/pg": "^8.21.0",
    "lefthook": "2.1.10",
    "turbo": "2.10.9"
  },
  "packageManager": "pnpm@11.1.0",
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "metro-runtime": "0.87.0",
    "pg": "^8.23.0"
  }
}
