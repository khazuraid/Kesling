# ── SECURITY NOTICE ────────────────────────────────────────────────────────────
# 1. Generate NEXTAUTH_SECRET using: openssl rand -base64 32
# 2. Never commit .env, .env.local, or .env.production to version control.
# 3. For production, set NEXTAUTH_URL to your secure HTTPS domain (e.g. https://kesling.biz.id).
# ──────────────────────────────────────────────────────────────────────────────

DATABASE_URL="postgresql://postgres:password@localhost:5432/kesling_cirebon"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Redis (caching & rate limiting)
REDIS_URL="redis://localhost:6379"

# Upstash Redis (for edge rate limiting - optional, falls back gracefully)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional: Email notifications
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""

# Cron job authentication
CRON_SECRET=""

# Optional: Sentry
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
