# ── SECURITY NOTICE ────────────────────────────────────────────────────────────
# 1. Generate NEXTAUTH_SECRET using: openssl rand -base64 32
# 2. Never commit .env, .env.local, or .env.production to version control.
# 3. For production, set NEXTAUTH_URL to your secure HTTPS domain (e.g. https://kesling.biz.id).
# ──────────────────────────────────────────────────────────────────────────────

DATABASE_URL="postgresql://postgres:password@localhost:5432/kesling_cirebon"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Redis (caching & rate limiting)
REDIS_URL="redis://localhost:6379"

# Upstash Redis (for edge rate limiting - optional, falls back gracefully)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional: Email notifications
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""

# Cron job authentication
CRON_SECRET=""

# Optional: Sentry
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# ── Akun seed (opsional) ─────────────────────────────────────────────
# User seed (Dinas Kesehatan, Operator Kesambi) HANYA dibuat bila variabel
# ini diisi. Nilai = bcrypt hash, bukan password polos.
#
# Buat hash (ganti password sesuai kebutuhan):
#   cd apps/web && node -e "console.log(require('bcryptjs').hashSync(process.argv[1],12))" "PasswordAnda#2026"
#
# Contoh hash di bawah = password "AdminKesling#2026" — WAJIB diganti.
# Akun yang dibuat dari seed ditandai wajib ganti password saat login pertama.
# SEED_DEFAULT_PASSWORD_HASH=$2b$12$6ONaLpHNUuIRSDcSTwg7YuIpk4tFtn0dMqJapDQxUSL.jsDzodcAK
SEED_DEFAULT_PASSWORD_HASH=

# Dipakai prisma/seed.ts (jalur lokal), password polos.
# Tanpa ini, admin dari seed.ts tidak dibuat.
SEED_ADMIN_EMAIL=[redacted]
SEED_ADMIN_PASSWORD=
